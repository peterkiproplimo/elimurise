import { useState, useRef, useEffect, useCallback } from "react";
import { useForm } from "react-hook-form";
import { yupResolver } from "@hookform/resolvers/yup";
import * as yup from "yup";
import { useLocation, useNavigate } from "react-router-dom";
import { CheckCircle, XCircle, Loader, AlertCircle, ArrowLeft, ChevronDown, ChevronUp, BookOpen, FileText, Layers, List, ToggleLeft, ToggleRight } from "lucide-react";
import * as ApiService from "../../services/auth";

// Interfaces
interface StrandFilter {
  grade: string;
  learning_area: string;
  term: string;
}

interface Assessment {
  learner: {
    _id: string;
    adm_no: string;
    first_name: string;
    last_name: string;
    surname: string;
  };
  assessmentDetails: {
    score: number;
    method: string;
    description: string;
    uploadUrl: string | null;
    published: boolean;
    _id?: string;
  };
}

interface ConfirmDialogProps {
  open: boolean;
  onConfirm: () => void;
  onCancel: () => void;
}

// Debounce utility
const debounce = <T extends (...args: any[]) => void>(func: T, wait: number) => {
  let timeout: NodeJS.Timeout;
  return (...args: Parameters<T>) => {
    clearTimeout(timeout);
    timeout = setTimeout(() => func(...args), wait);
  };
};

// ProgressBar Component
const ProgressBar: React.FC<{ total: number; assessed: number }> = ({ total, assessed }) => {
  const percentage = total ? (assessed / total) * 100 : 0;
  return (
    <div className="w-full bg-gray-200 rounded-full h-2.5">
      <div
        className="bg-blue-600 h-2.5 rounded-full transition-all duration-300"
        style={{ width: `${percentage}%` }}
      ></div>
    </div>
  );
};

// ConfirmDialog Component
const ConfirmDialog: React.FC<ConfirmDialogProps> = ({ open, onConfirm, onCancel }) => (
  <div className={`fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center ${open ? '' : 'hidden'}`}>
    <div className="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-lg max-w-sm w-full">
      <AlertCircle className="w-16 h-16 mx-auto text-yellow-500" />
      <h3 className="mt-4 text-2xl font-semibold text-gray-800 dark:text-gray-100 text-center">Are you sure?</h3>
      <p className="mt-2 text-gray-600 dark:text-gray-300 text-center">
        This action is irreversible. Confirm to proceed.
      </p>
      <div className="mt-6 flex justify-center space-x-4">
        <button
          onClick={onCancel}
          className="px-4 py-2 bg-gray-200 text-gray-800 rounded-lg hover:bg-gray-300 transition"
        >
          Cancel
        </button>
        <button
          onClick={onConfirm}
          className="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition"
        >
          Confirm
        </button>
      </div>
    </div>
  </div>
);

const Main: React.FC = () => {
  const [confirmDialog, setConfirmDialog] = useState<ConfirmDialogProps>({ open: false, onConfirm: () => {}, onCancel: () => {} });
  const [dialog, setDialog] = useState(false);
  const [publish, setPublish] = useState(false);
  const [grades, setGrades] = useState<any[]>([]);
  const [learningAreas, setLearningAreas] = useState<any[]>([]);
  const [strands, setStrands] = useState<any[]>([]);
  const [streams, setStreams] = useState<any[]>([]);
  const [substrands, setSubstrands] = useState<any[]>([]);
  const [stream, setStream] = useState("");
  const [substrand, setSubstrand] = useState<any>({});
  const [indicator, setIndicator] = useState("");
  const [selectedTerm, setSelectedTerm] = useState("");
  const [strand, setStrand] = useState("");
  const [selectedSubStrand, setSelectedSubStrand] = useState("");
  const [enrollments, setEnrollments] = useState<Assessment[]>([]);
  const [adm_no, setAdmNo] = useState("");
  const [loading, setLoading] = useState(false);
  const [success, setSuccess] = useState(true);
  const [message, setMessage] = useState("");
  const [assessmentMethods, setAssessmentMethods] = useState<string[]>([]);
  const [uploadedFiles, setUploadedFiles] = useState<{ [key: string]: File | null }>({});
  const [saveStatus, setSaveStatus] = useState<{ [key: string]: "idle" | "saving" | "saved" | "error" }>({});
  const [isGradesLoading, setIsGradesLoading] = useState(false);
  const [isStreamsLoading, setIsStreamsLoading] = useState(false);
  const [isLearningAreasLoading, setIsLearningAreasLoading] = useState(false);
  const [isStrandsLoading, setIsStrandsLoading] = useState(false);
  const [isSubstrandsLoading, setIsSubstrandsLoading] = useState(false);
  const [isActivitiesOpen, setIsActivitiesOpen] = useState(false);
  const notify = useRef<{ showToast: () => void } | null>(null);
  const navigate = useNavigate();
  const location = useLocation();
  const learningArea = location?.state?.data;

  const initialState: StrandFilter = {
    grade: learningArea?.grade_id?._id || "",
    learning_area: learningArea?._id || "",
    term: learningArea?._id ? "1" : "",
  };

  const [strandFilter, setStrandFilter] = useState<StrandFilter>(initialState);

  const terms = [
    { _id: "1", name: "Term 1" },
    { _id: "2", name: "Term 2" },
    { _id: "3", name: "Term 3" },
  ];

  const schema = yup.object({
    score: yup.array().of(
      yup.number().required("Score is required").min(1, "Minimum value is 1").max(4, "Maximum value is 4")
    ),
    assessmentMethod: yup.array().of(yup.string().required("Assessment method is required")),
  }).required();

  const { register, reset, formState: { errors } } = useForm({
    mode: "onChange",
    resolver: yupResolver(schema),
  });

  const getEnrollments = useCallback(async () => {
    if (!stream || !indicator) return;
    setLoading(true);
    try {
      const enrollments = await ApiService.getEnrolments({ stream }, {});
      setEnrollments(enrollments?.data || []);
    } catch (error: any) {
      setSuccess(false);
      setMessage(error.message || "Failed to fetch enrollments.");
      notify.current?.showToast();
    } finally {
      setLoading(false);
    }
  }, [stream, indicator]);

  const getGrades = useCallback(async () => {
    setIsGradesLoading(true);
    try {
      const response = await ApiService.getGrades({ page: 1 });
      setGrades(response.data || []);
    } catch (error: any) {
      setSuccess(false);
      setMessage(error.message || "Failed to fetch grades.");
      notify.current?.showToast();
    } finally {
      setIsGradesLoading(false);
    }
  }, []);

  const getLearningAreas = useCallback(async () => {
    setIsLearningAreasLoading(true);
    try {
      const response = await ApiService.getLearningAreas({});
      setLearningAreas(response.data || []);
    } catch (error: any) {
      setSuccess(false);
      setMessage(error.message || "Failed to fetch learning areas.");
      notify.current?.showToast();
    } finally {
      setIsLearningAreasLoading(false);
    }
  }, []);

  const getStreams = useCallback(async (grade: string) => {
    if (!grade) return;
    setIsStreamsLoading(true);
    try {
      const response = await ApiService.getStream({ page: 1, grade });
      setStreams(response.data || []);
    } catch (error: any) {
      setSuccess(false);
      setMessage(error.message || "Failed to fetch streams.");
      notify.current?.showToast();
    } finally {
      setIsStreamsLoading(false);
    }
  }, []);

  const getStrands = useCallback(async () => {
    if (!strandFilter.grade || !strandFilter.term) return;
    setIsStrandsLoading(true);
    try {
      const response = await ApiService.getStrands({ page: 1, search: "", limit: 1000 }, strandFilter);
      setStrands(response.data || []);
    } catch (error: any) {
      setSuccess(false);
      setMessage(error.message || "Failed to fetch strands.");
      notify.current?.showToast();
    } finally {
      setIsStrandsLoading(false);
    }
  }, [strandFilter]);

  const fetchIndicator = useCallback(async () => {
    if (!stream || !selectedSubStrand) return;
    setLoading(true);
    try {
      const response = await ApiService.getSingleSubstrand(stream, selectedSubStrand);
      setSubstrand(response.data || {});
    } catch (error: any) {
      setSuccess(false);
      setMessage(error.message || "Failed to fetch indicator.");
      notify.current?.showToast();
    } finally {
      setLoading(false);
    }
  }, [stream, selectedSubStrand]);

  const formatAssessmentMethodsAsHtml = (htmlString: string): string[] => {
    if (!htmlString) return [];
    const parser = new DOMParser();
    const doc = parser.parseFromString(htmlString, "text/html");
    let items: string[] = [];
    const liItems = Array.from(doc.querySelectorAll("li"));
    if (liItems.length > 0) {
      return liItems.map((li) => li.textContent?.trim() || "").filter((text) => !!text);
    }
    const paragraphs = Array.from(doc.querySelectorAll("p"));
    paragraphs.forEach((p) => {
      const html = p.innerHTML.replace(/<br\s*\/?>/gi, "\n");
      const lines = html
        .split(/\n|•/g)
        .map((line) => line.replace(/&nbsp;/g, " ").trim())
        .filter((line) => !!line);
      items.push(...lines);
    });
    return items;
  };

  const generateAssessment = useCallback(async (indicatorId: string) => {
    if (!stream || !selectedTerm || !strandFilter.learning_area || !indicatorId) {
      setSuccess(false);
      setMessage("Please select all required fields (Stream, Term, Learning Area, Indicator).");
      notify.current?.showToast();
      return;
    }
    setLoading(true);
    try {
      const data = { indicator: indicatorId, term: selectedTerm, stream, adm_no };
      const res = await ApiService.getAssessmentLerners(data);
      setEnrollments(res.data || []);
      setAssessmentMethods(res.data.map((assessment: Assessment) => assessment?.assessmentDetails?.method || ""));
      setPublish(res.published);
      setDialog(true);
    } catch (error: any) {
      setSuccess(false);
      setMessage(error.message || "Failed to generate assessment.");
      notify.current?.showToast();
    } finally {
      setLoading(false);
    }
  }, [stream, selectedTerm, strandFilter.learning_area, adm_no]);

  const handleInputChange = async (assessment: Assessment, index: number, field: string, value: any) => {
    const learnerId = assessment?.learner?._id;
    if (!learnerId) return;

    if (field !== "description" && (!substrand?._id || !indicator || !selectedTerm || !strandFilter.learning_area || !strand || !learnerId)) {
      setSuccess(false);
      setMessage("Please ensure all required fields are selected.");
      notify.current?.showToast();
      return;
    }

    setSaveStatus((prev) => ({ ...prev, [learnerId]: "saving" }));

    try {
      const updatedAssessment: any = {
        substrand: substrand?._id,
        indicator,
        term: selectedTerm,
        learning_area: strandFilter.learning_area,
        score: field === "score" ? Number(value) : Number(assessment?.assessmentDetails?.score || 1),
        strand,
        learner: learnerId,
        method: field === "method" ? value : assessment?.assessmentDetails?.method || assessmentMethods[index],
        description: assessment?.assessmentDetails?.description || "",
        additionalDescription: assessment?.assessmentDetails?.description || "",
      };

      if (field === "file" && value) {
        const formData = new FormData();
        formData.append("file", value);
        formData.append("learner", learnerId);
        formData.append("term", selectedTerm);
        formData.append("strand", strand);
        formData.append("substrand", substrand?._id);
        formData.append("indicator", indicator);
        formData.append("learning_area", strandFilter.learning_area);
        formData.append("score", updatedAssessment.score.toString());
        formData.append("method", updatedAssessment.method);
        formData.append("additionalDescription", updatedAssessment.description);
        formData.append("description", updatedAssessment.description);

        const response = await ApiService.createAssessment(formData);
        setUploadedFiles((prev) => ({ ...prev, [learnerId]: value }));
        updatedAssessment.uploadUrl = response.uploadUrl;
      } else {
        await ApiService.createAssessment(updatedAssessment);
      }

      await generateAssessment(indicator);
      await fetchIndicator();
      setSaveStatus((prev) => ({ ...prev, [learnerId]: "saved" }));

      setTimeout(() => {
        setSaveStatus((prev) => ({ ...prev, [learnerId]: "idle" }));
      }, 2000);
    } catch (error: any) {
      setSaveStatus((prev) => ({ ...prev, [learnerId]: "error" }));
      setSuccess(false);
      setMessage(error.message || "Failed to save assessment.");
      notify.current?.showToast();
    }
  };

  const handleGradeChange = useCallback(async (event: React.ChangeEvent<HTMLSelectElement>) => {
    const selectedValue = event.target.value;
    setStream("");
    setStrands([]);
    setSelectedSubStrand("");
    setSubstrands([]);
    setIndicator("");
    setStrandFilter((prev) => ({ ...prev, grade: selectedValue, learning_area: "", term: "" }));
    await getStreams(selectedValue);
  }, [getStreams]);

  const handleLearningAreaChange = useCallback(async (event: React.ChangeEvent<HTMLSelectElement>) => {
    const selectedValue = event.target.value;
    setStrands([]);
    setSelectedSubStrand("");
    setSubstrands([]);
    setIndicator("");
    setStrandFilter((prev) => ({ ...prev, learning_area: selectedValue }));
  }, []);

  const handleTermChange = useCallback(async (event: React.ChangeEvent<HTMLSelectElement>) => {
    const selectedValue = event.target.value;
    setStrands([]);
    setStrandFilter((prev) => ({ ...prev, term: selectedValue }));
    setSelectedTerm(selectedValue);
  }, []);

  const handleStrandChange = useCallback(async (event: React.ChangeEvent<HTMLSelectElement>) => {
    const selectedValue = event.target.value;
    setSubstrands([]);
    setSelectedSubStrand("");
    setIndicator("");
    setStrand(selectedValue);
    try {
      const res = await ApiService.getSubstrandByStrand({ limit: 10000 }, selectedValue);
      setSubstrands(res.data || []);
    } catch (error: any) {
      setSuccess(false);
      setMessage(error.message || "Failed to fetch substrands.");
      notify.current?.showToast();
    }
  }, []);

  const handleSubStrandChange = useCallback((value: string) => {
    setSelectedSubStrand(value);
  }, []);

  const publishIndicator = useCallback(async (value: boolean) => {
    const confirmed = await new Promise((resolve) => {
      setConfirmDialog({
        open: true,
        onConfirm: () => resolve(true),
        onCancel: () => resolve(false),
      });
    });

    if (confirmed && indicator && selectedTerm && stream) {
      setLoading(true);
      try {
        await ApiService.toggleIdicatorStatus(indicator, { term: selectedTerm, stream, publish: value });
        setPublish(value);
        await generateAssessment(indicator);
        setSuccess(true);
        setMessage("Indicator published successfully.");
        notify.current?.showToast();
      } catch (error: any) {
        setSuccess(false);
        setMessage(error.message || "Failed to publish indicator.");
        notify.current?.showToast();
      } finally {
        setLoading(false);
      }
    }
  }, [indicator, selectedTerm, stream, generateAssessment]);

  useEffect(() => {
    getGrades();
    getLearningAreas();
  }, [getGrades, getLearningAreas]);

  useEffect(() => {
    getEnrollments();
  }, [getEnrollments]);

  useEffect(() => {
    getStrands();
  }, [getStrands]);

  useEffect(() => {
    fetchIndicator();
  }, [fetchIndicator]);

  useEffect(() => {
    if (indicator && stream && selectedTerm && strandFilter.learning_area) {
      generateAssessment(indicator);
    }
  }, [indicator, stream, selectedTerm, strandFilter.learning_area, generateAssessment]);

  useEffect(() => {
    localStorage.setItem("strandFilter", JSON.stringify(strandFilter));
  }, [strandFilter]);

  // Mock data for Substrand activities (replace with actual data if available)
  const substrandActivities = [
    "Sorting and matching objects",
    "Ordering objects",
    "Creating patterns",
  ];

  return (
    <div className="min-h-screen bg-gray-100 dark:bg-gray-900 p-6">
      <ConfirmDialog
        open={confirmDialog.open}
        onConfirm={() => {
          confirmDialog.onConfirm();
          setConfirmDialog({ ...confirmDialog, open: false });
        }}
        onCancel={() => {
          confirmDialog.onCancel();
          setConfirmDialog({ ...confirmDialog, open: false });
        }}
      />
      {dialog ? (
        <div className="max-w-7xl mx-auto">
          <div className="flex items-center mb-6">
            <button
              onClick={() => { reset(); setDialog(false); }}
              className="mr-3 text-gray-500 hover:text-gray-700 transition"
            >
              <ArrowLeft className="w-6 h-6" />
            </button>
            <h2 className="text-2xl font-bold text-gray-800 dark:text-gray-100">Assessment Score Entry</h2>
          </div>
          <div className="bg-gradient-to-r from-blue-500 to-indigo-600 dark:from-blue-700 dark:to-indigo-800 p-6 rounded-xl shadow-lg mb-6 text-white">
            <div className="flex flex-col sm:flex-row sm:space-x-4 space-y-4 sm:space-y-0">
              <div className="flex-1 bg-white dark:bg-gray-800 p-4 rounded-lg shadow-sm transform hover:scale-105 transition-transform duration-200">
                <div className="flex items-center space-x-2">
                  <BookOpen className="w-5 h-5 text-blue-500" />
                  <span className="font-semibold text-gray-700 dark:text-gray-200">Grade</span>
                </div>
                <p className="mt-1 text-gray-800 dark:text-gray-100 uppercase">
                  {substrand?.strand?.learning_area?.grade_id?.name || "N/A"}
                </p>
              </div>
              <div className="flex-1 bg-white dark:bg-gray-800 p-4 rounded-lg shadow-sm transform hover:scale-105 transition-transform duration-200">
                <div className="flex items-center space-x-2">
                  <FileText className="w-5 h-5 text-blue-500" />
                  <span className="font-semibold text-gray-700 dark:text-gray-200">Learning Area</span>
                </div>
                <p className="mt-1 text-gray-800 dark:text-gray-100 uppercase">
                  {substrand?.strand?.learning_area?.name || "N/A"}
                </p>
              </div>
              <div className="flex-1 bg-white dark:bg-gray-800 p-4 rounded-lg shadow-sm transform hover:scale-105 transition-transform duration-200">
                <div className="flex items-center space-x-2">
                  <Layers className="w-5 h-5 text-blue-500" />
                  <span className="font-semibold text-gray-700 dark:text-gray-200">Strand</span>
                </div>
                <p className="mt-1 text-gray-800 dark:text-gray-100">
                  {substrand?.strand?.name || "N/A"}
                </p>
              </div>
              <div className="flex-1 bg-white dark:bg-gray-800 p-4 rounded-lg shadow-sm transform hover:scale-105 transition-transform duration-200">
                <div className="flex items-center space-x-2 cursor-pointer" onClick={() => setIsActivitiesOpen(!isActivitiesOpen)}>
                  <List className="w-5 h-5 text-blue-500" />
                  <span className="font-semibold text-gray-700 dark:text-gray-200">Substrand</span>
                  {isActivitiesOpen ? <ChevronUp className="w-5 h-5 text-blue-500" /> : <ChevronDown className="w-5 h-5 text-blue-500" />}
                </div>
                <p className="mt-1 text-gray-800 dark:text-gray-100" dangerouslySetInnerHTML={{ __html: substrand.name || "N/A" }} />
                {isActivitiesOpen && (
                  <ul className="mt-2 text-sm text-gray-600 dark:text-gray-300 list-disc list-inside">
                    {substrandActivities.map((activity, index) => (
                      <li key={index}>{activity}</li>
                    ))}
                  </ul>
                )}
              </div>
              <div className="flex-1 bg-white dark:bg-gray-800 p-4 rounded-lg shadow-sm transform hover:scale-105 transition-transform duration-200">
                <div className="flex items-center space-x-2">
                  <FileText className="w-5 h-5 text-blue-500" />
                  <span className="font-semibold text-gray-700 dark:text-gray-200">Indicator</span>
                </div>
                <p className="mt-1 text-gray-800 dark:text-gray-100">
                  {substrand?.indicators?.flat().find((ind: any) => ind._id === indicator)?.description || "N/A"}
                </p>
              </div>
            </div>
            <div className="mt-4 flex items-center justify-between">
              {/* <div className="flex items-center space-x-2">
                <span className="font-semibold text-white">Publish</span>
                <button
                  onClick={() => publishIndicator(!publish)}
                  className={`flex items-center p-1 rounded-full ${publish ? 'bg-green-500' : 'bg-gray-300'}`}
                >
                  {publish ? (
                    <ToggleRight className="w-6 h-6 text-white" />
                  ) : (
                    <ToggleLeft className="w-6 h-6 text-gray-500" />
                  )}
                </button>
              </div> */}
             
            </div>
          </div>
          <div className="mb-4">
            <div className="relative w-full sm:w-64">
              <input
                type="text"
                className="w-full p-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                placeholder="Search by Adm No..."
                onChange={(e) => setAdmNo(e.target.value)}
              />
              <svg className="absolute right-3 top-2.5 h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
          </div>
          <div className="bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-x-auto">
            <table className="w-full">
              <thead className="bg-gray-50 dark:bg-gray-700">
                <tr>
                  <th className="py-3 px-4 text-left text-sm font-semibold text-gray-700 dark:text-gray-300">No</th>
                  <th className="py-3 px-4 text-left text-sm font-semibold text-gray-700 dark:text-gray-300">Adm No</th>
                  <th className="py-3 px-4 text-left text-sm font-semibold text-gray-700 dark:text-gray-300">Name</th>
                  <th className="py-3 px-4 text-left text-sm font-semibold text-gray-700 dark:text-gray-300">Score</th>
                </tr>
              </thead>
              <tbody>
                {enrollments.map((assessment, key) => {
                  const learnerId = assessment?.learner?._id;
                  return (
                    <tr key={key} className="border-b dark:border-gray-700">
                      <td className="py-3 px-4 text-gray-800 dark:text-gray-200">{key + 1}</td>
                      <td className="py-3 px-4 text-gray-800 dark:text-gray-200">{assessment?.learner?.adm_no || "N/A"}</td>
                      <td className="py-3 px-4 text-gray-800 dark:text-gray-200">
                        {`${assessment?.learner?.first_name || ""} ${assessment?.learner?.last_name || ""} ${assessment?.learner?.surname || ""}`}
                      </td>
                      <td className="py-3 px-4">
                        <div className="flex space-x-2">
                          <button
                            className={`px-3 py-1 rounded-lg text-sm font-medium transition-all duration-200 ${
                              assessment?.assessmentDetails?.score === 4
                                ? "bg-green-600 text-white"
                                : "bg-gray-200 text-gray-800 hover:bg-green-100"
                            } ${assessment?.assessmentDetails?.published ? "opacity-50 cursor-not-allowed" : ""}`}
                            onClick={() => handleInputChange(assessment, key, "score", 4)}
                            disabled={assessment?.assessmentDetails?.published}
                          >
                            EE
                          </button>
                          <button
                            className={`px-3 py-1 rounded-lg text-sm font-medium transition-all duration-200 ${
                              assessment?.assessmentDetails?.score === 3
                                ? "bg-blue-600 text-white"
                                : "bg-gray-200 text-gray-800 hover:bg-blue-100"
                            } ${assessment?.assessmentDetails?.published ? "opacity-50 cursor-not-allowed" : ""}`}
                            onClick={() => handleInputChange(assessment, key, "score", 3)}
                            disabled={assessment?.assessmentDetails?.published}
                          >
                            ME
                          </button>
                          <button
                            className={`px-3 py-1 rounded-lg text-sm font-medium transition-all duration-200 ${
                              assessment?.assessmentDetails?.score === 2
                                ? "bg-yellow-600 text-white"
                                : "bg-gray-200 text-gray-800 hover:bg-yellow-100"
                            } ${assessment?.assessmentDetails?.published ? "opacity-50 cursor-not-allowed" : ""}`}
                            onClick={() => handleInputChange(assessment, key, "score", 2)}
                            disabled={assessment?.assessmentDetails?.published}
                          >
                            AE
                          </button>
                          <button
                            className={`px-3 py-1 rounded-lg text-sm font-medium transition-all duration-200 ${
                              assessment?.assessmentDetails?.score === 1
                                ? "bg-red-600 text-white"
                                : "bg-gray-200 text-gray-800 hover:bg-red-100"
                            } ${assessment?.assessmentDetails?.published ? "opacity-50 cursor-not-allowed" : ""}`}
                            onClick={() => handleInputChange(assessment, key, "score", 1)}
                            disabled={assessment?.assessmentDetails?.published}
                          >
                            BE
                          </button>
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>
      ) : (
        <div className="max-w-7xl mx-auto">
          <h2 className="text-2xl font-bold text-gray-800 dark:text-gray-100 mb-6">{learningArea?.name || "N/A"}</h2>
          <div className="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-md mb-6">
            <h3 className="text-lg font-semibold text-gray-800 dark:text-gray-100 mb-4">Learner Details</h3>
            <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div className="relative">
                <label className="block text-sm font-medium text-gray-700 dark:text-gray-300">Grade</label>
                <select
                  {...register("grade")}
                  value={strandFilter.grade}
                  onChange={handleGradeChange}
                  className="mt-1 block w-full p-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                >
                  <option value="">Select Grade</option>
                  {grades.map((grade: any) => (
                    <option key={grade._id} value={grade._id}>{grade.name}</option>
                  ))}
                </select>
                {isGradesLoading && (
                  <Loader className="absolute right-2 top-10 h-4 w-4 text-blue-500 animate-spin" />
                )}
                {errors.grade?.message && (
                  <p className="mt-1 text-sm text-red-600">{String(errors.grade.message)}</p>
                )}
              </div>
              <div className="relative">
                <label className="block text-sm font-medium text-gray-700 dark:text-gray-300">Stream</label>
                <select
                  {...register("stream")}
                  value={stream}
                  onChange={(e) => setStream(e.target.value)}
                  className="mt-1 block w-full p-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                >
                  <option value="">Select Stream</option>
                  {streams.map((stream: any) => (
                    <option key={stream._id} value={stream._id}>{stream.name}</option>
                  ))}
                </select>
                {isStreamsLoading && (
                  <Loader className="absolute right-2 top-10 h-4 w-4 text-blue-500 animate-spin" />
                )}
                {errors.stream?.message && (
                  <p className="mt-1 text-sm text-red-600">{String(errors.stream.message)}</p>
                )}
              </div>
              <div>
                <label className="block text-sm font-medium text-gray-700 dark:text-gray-300">Academic Term</label>
                <select
                  value={selectedTerm}
                  onChange={(e) => setSelectedTerm(e.target.value)}
                  className="mt-1 block w-full p-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                >
                  <option value="">Select Academic Term</option>
                  {terms.map((term) => (
                    <option key={term._id} value={term._id}>{term.name}</option>
                  ))}
                </select>
                {errors.term?.message && (
                  <p className="mt-1 text-sm text-red-600">{String(errors.term.message)}</p>
                )}
              </div>
            </div>
          </div>
          <div className="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-md">
            <h3 className="text-lg font-semibold text-gray-800 dark:text-gray-100 mb-4">Assessment Details</h3>
            <div className="grid grid-cols-1 sm:grid-cols-4 gap-4">
              <div className="relative">
                <label className="block text-sm font-medium text-gray-700 dark:text-gray-300">Learning Area</label>
                <select
                  {...register("learning_area")}
                  value={strandFilter.learning_area}
                  onChange={handleLearningAreaChange}
                  className="mt-1 block w-full p-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                >
                  <option value="">Select Learning Area</option>
                  {learningAreas
                    .filter((area: any) => area?.grade_id?._id === strandFilter?.grade)
                    .map((area: any) => (
                      <option key={area._id} value={area._id}>{area.name}</option>
                    ))}
                </select>
                {isLearningAreasLoading && (
                  <Loader className="absolute right-2 top-10 h-4 w-4 text-blue-500 animate-spin" />
                )}
                {errors.learning_area?.message && (
                  <p className="mt-1 text-sm text-red-600">{String(errors.learning_area.message)}</p>
                )}
              </div>
              <div>
                <label className="block text-sm font-medium text-gray-700 dark:text-gray-300">Term</label>
                <select
                  {...register("term")}
                  value={strandFilter.term}
                  onChange={handleTermChange}
                  className="mt-1 block w-full p-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                >
                  <option value="">Select Term</option>
                  {terms.map((term) => (
                    <option key={term._id} value={term._id}>{term.name}</option>
                  ))}
                </select>
                {errors.term?.message && (
                  <p className="mt-1 text-sm text-red-600">{String(errors.term.message)}</p>
                )}
              </div>
              <div className="relative">
                <label className="block text-sm font-medium text-gray-700 dark:text-gray-300">Strand</label>
                <select
                  {...register("strand")}
                  value={strand}
                  onChange={handleStrandChange}
                  className="mt-1 block w-full p-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                >
                  <option value="">Select Strand</option>
                  {Object.entries(strands.reduce((acc: Record<string, any[]>, strand) => {
                    const theme = strand.theme && strand.theme !== "N/A" ? strand.theme : "No Theme";
                    if (!acc[theme]) acc[theme] = [];
                    acc[theme].push(strand);
                    return acc;
                  }, {})).map(([theme, strands]: [string, any[]]) => (
                    <optgroup key={theme} label={theme}>
                      {strands.sort((a, b) => a.name.localeCompare(b.name)).map((strand) => (
                        <option key={strand._id} value={strand._id}>{strand.name}</option>
                      ))}
                    </optgroup>
                  ))}
                </select>
                {isStrandsLoading && (
                  <Loader className="absolute right-2 top-10 h-4 w-4 text-blue-500 animate-spin" />
                )}
                {errors.strand?.message && (
                  <p className="mt-1 text-sm text-red-600">{String(errors.strand.message)}</p>
                )}
              </div>
              <div className="relative">
                <label className="block text-sm font-medium text-gray-700 dark:text-gray-300">Substrand</label>
                <select
                  {...register("substrand")}
                  value={selectedSubStrand}
                  onChange={(e) => handleSubStrandChange(e.target.value)}
                  className="mt-1 block w-full p-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                >
                  <option value="">Select Substrand</option>
                  {substrands.map((substrand) => (
                    <option key={substrand._id} value={substrand._id} dangerouslySetInnerHTML={{ __html: substrand.name }} />
                  ))}
                </select>
                {isSubstrandsLoading && (
                  <Loader className="absolute right-2 top-10 h-4 w-4 text-blue-500 animate-spin" />
                )}
                {errors.substrand?.message && (
                  <p className="mt-1 text-sm text-red-600">{String(errors.substrand.message)}</p>
                )}
              </div>
            </div>
          </div>
          <div className="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-md">
            <h3 className="text-lg font-semibold text-gray-800 dark:text-gray-100 mb-4">Indicators</h3>
            <div className="overflow-x-auto">
              <table className="w-full">
                <thead className="bg-gray-50 dark:bg-gray-700">
                  <tr>
                    <th className="py-3 px-4 text-left text-sm font-semibold text-gray-700 dark:text-gray-300">Description</th>
                    <th className="py-3 px-4 text-left text-sm font-semibold text-gray-700 dark:text-gray-300">Progress</th>
                    <th className="py-3 px-4 text-left text-sm font-semibold text-gray-700 dark:text-gray-300">Method</th>
                    <th className="py-3 px-4 text-left text-sm font-semibold text-gray-700 dark:text-gray-300">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {substrand?.indicators?.map((indicator: any, key: number) => (
                    <tr key={key} className="border-b dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700">
                      <td className="py-3 px-4 text-gray-800 dark:text-gray-200">{indicator[0]?.description || "N/A"}</td>
                      <td className="py-3 px-4">
                        <ProgressBar total={indicator[0]?.total_learners || 0} assessed={indicator[0]?.total_learners_assessed || 0} />
                      </td>
                      <td className="py-3 px-4">
                        <select
                          className="w-32 p-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                          value={indicator[0]?.method || ""}
                          onChange={(e) => {
                            setSubstrand((prev: any) => {
                              if (!prev) return prev;
                              const updatedIndicators = [...prev.indicators];
                              updatedIndicators[key] = [{ ...indicator[0], method: e.target.value }];
                              return { ...prev, indicators: updatedIndicators };
                            });
                          }}
                        >
                          <option value="">Select Method</option>
                          {formatAssessmentMethodsAsHtml(substrand?.suggested_assessment_methods).map((method, idx) => (
                            <option key={idx} value={method}>{method}</option>
                          ))}
                        </select>
                      </td>
                      <td className="py-3 px-4">
                        <button
                          onClick={() => {
                            if (!indicator[0]?.method) {
                              alert("Select Assessment Method");
                              return;
                            }
                            setUploadedFiles({});
                            setIndicator(indicator[0]?._id);
                            generateAssessment(indicator[0]?._id);
                          }}
                          className="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition disabled:bg-gray-400"
                          disabled={!stream || !selectedTerm || !strandFilter.learning_area}
                        >
                          Assess
                          {loading && <Loader className="inline-block ml-2 h-4 w-4 animate-spin" />}
                        </button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            {errors.indicator?.message && (
              <p className="mt-3 text-sm text-red-600">{String(errors.indicator.message)}</p>
            )}
          </div>
        </div>
      )}
      <div className={`fixed bottom-4 right-4 flex items-center p-4 rounded-lg shadow-md ${success ? 'bg-green-100' : 'bg-red-100'}`}>
        {success ? <CheckCircle className="h-6 w-6 text-green-600" /> : <XCircle className="h-6 w-6 text-red-600" />}
        <div className="ml-3">
          <p className="font-medium text-gray-800">{success ? "Success" : "Failed"}</p>
          <p className="text-sm text-gray-600">{message}</p>
        </div>
      </div>
    </div>
  );
};

export default Main;